+			if ( hr == S_FALSE ) continue;
+			if ( FAILED( hr ) ) { slot.pending = false; ++m_timingDropped; continue; }
+			hr = context.context->GetData( slot.end, &end, UINT( sizeof( end ) ), D3D11_ASYNC_GETDATA_DONOTFLUSH );
