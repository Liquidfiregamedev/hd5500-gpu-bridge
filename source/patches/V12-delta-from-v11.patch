+			m_cpuTimingSamples.push_back( cpuMs );
+			slot.pending = false;
+			if ( m_gpuTimingSamples.size() == 120u )
+			{
+				std::fprintf( stderr, "[RW-GPU-TIMING] samples=120 dropped=%llu disjoint=%llu gpu_ms_median=%.3f gpu_ms_p90=%.3f cpu_submit_ms_median=%.3f\n"
