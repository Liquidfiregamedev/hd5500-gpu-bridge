+		slot.cpuEnd = cpuEnd;
+		context.context->End( slot.end );
+		context.context->End( slot.disjoint );
+		slot.pending = true;
+		m_activeTiming = nullptr;
+		m_timingNext = ( m_timingNext + 1u ) % uint32_t( m_timingSlots.size() );
