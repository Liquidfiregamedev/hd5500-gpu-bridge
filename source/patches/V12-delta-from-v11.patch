+					, static_cast< unsigned long long >( m_timingDisjoint )
+					, percentile( m_gpuTimingSamples, 0.50 )
+					, percentile( m_gpuTimingSamples, 0.90 )
+					, percentile( m_cpuTimingSamples, 0.50 ) );
+				m_gpuTimingSamples.clear();
+				m_cpuTimingSamples.clear();
+			}
+		}
