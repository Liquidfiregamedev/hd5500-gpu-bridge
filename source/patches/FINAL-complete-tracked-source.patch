--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11ResourceMap.hpp
@@ -0,0 +1,490 @@
+/*
+This file belongs to Ashes.
+See LICENSE file in root folder.
+*/
+#pragma once
+
+#include <atomic>
+#include <cstdio>
+
+namespace ashes::D3D11_NAMESPACE::resmap
+{
+	namespace detail
+	{
+		struct ResourceDesc
+		{
+			D3D11_RESOURCE_DIMENSION dimension{ D3D11_RESOURCE_DIMENSION_UNKNOWN };
+			D3D11_USAGE usage{};
+			UINT cpuAccess{};
+			UINT bind{};
+			UINT misc{};
+			UINT byteWidth{};
+			UINT width{};
+			UINT height{ 1u };
+			UINT depth{ 1u };
+			UINT mipLevels{ 1u };
+			UINT arraySize{ 1u };
+			UINT sampleCount{ 1u };
+			UINT sampleQuality{};
+			DXGI_FORMAT format{ DXGI_FORMAT_UNKNOWN };
+		};
+
+		struct DeviceRef
+		{
+			ID3D11Device * value{};
+
+			~DeviceRef()noexcept
+			{
+				if ( value )
+				{
+					value->Release();
+				}
+			}
+		};
+
+		inline void trace( char const * stage
+			, HRESULT hr
+			, ResourceDesc const & desc
+			, UINT subresource
+				, D3D11_MAP map )noexcept
+			{
+				std::fprintf( stderr,
+					"[RW-GPU-MAP] %s hr=0x%08lX dim=%u sub=%u map=%u usage=%u cpu=0x%X bind=0x%X misc=0x%X format=%u bytes=%u size=%ux%ux%u mips=%u array=%u samples=%u:%u\n",
+					stage,
+					static_cast< unsigned long >( hr ),
+					unsigned( desc.dimension ),
+				subresource,
+				unsigned( map ),
+				unsigned( desc.usage ),
+				desc.cpuAccess,
+				desc.bind,
+				desc.misc,
+				unsigned( desc.format ),
+				desc.byteWidth,
+				desc.width,
+				desc.height,
+				desc.depth,
+				desc.mipLevels,
+				desc.arraySize,
+				desc.sampleCount,
+				desc.sampleQuality );
+			std::fflush( stderr );
+		}
+
+		inline bool isSubresource( ResourceDesc const & desc, UINT subresource )noexcept
+		{
+			uint64_t count{};
+
+			switch ( desc.dimension )
+			{
+			case D3D11_RESOURCE_DIMENSION_BUFFER:
+				count = 1u;
+				break;
+			case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
+			case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
+				count = uint64_t( desc.mipLevels ) * desc.arraySize;
+				break;
+			case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
+				count = desc.mipLevels;
+				break;
+			default:
+				return false;
+			}
+
+			return uint64_t( subresource ) < count;
+		}
+
+		inline UINT requiredCpuAccess( D3D11_MAP map )noexcept
+		{
+			switch ( map )
+			{
+			case D3D11_MAP_READ:
+				return D3D11_CPU_ACCESS_READ;
+			case D3D11_MAP_WRITE:
+				return D3D11_CPU_ACCESS_WRITE;
+			case D3D11_MAP_READ_WRITE:
+				return D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+			default:
+				return 0u;
+			}
+		}
+
+		inline bool isDirectStagingMap( ResourceDesc const & desc, D3D11_MAP map )noexcept
+		{
+			auto const required = requiredCpuAccess( map );
+			return desc.usage == D3D11_USAGE_STAGING
+				&& required != 0u
+				&& ( desc.cpuAccess & required ) == required;
+		}
+
+		inline bool isDirectDynamicMap( ResourceDesc const & desc, D3D11_MAP map )noexcept
+		{
+			// WRITE_DISCARD is the map request this renderer emits for dynamic,
+			// pipeline-bound buffers.  Other modes are deliberately staged rather
+			// than relying on implementation-specific D3D11 Map acceptance.
+			return desc.usage == D3D11_USAGE_DYNAMIC
+				&& map == D3D11_MAP_WRITE_DISCARD
+				&& ( desc.cpuAccess & D3D11_CPU_ACCESS_WRITE ) != 0u;
+		}
+
+		inline bool canCopyBack( ResourceDesc const & desc )noexcept
+		{
+			// An immutable resource cannot be the destination of the copy made by
+			// unlock().  It has no legal writable map path either.
+			return desc.usage != D3D11_USAGE_IMMUTABLE;
+		}
+
+		inline void traceFallback( ResourceDesc const & desc
+			, UINT subresource
+			, D3D11_MAP map )noexcept
+		{
+			static std::atomic< unsigned long > count{ 0u };
+			auto const ordinal = count.fetch_add( 1u, std::memory_order_relaxed ) + 1u;
+
+				if ( ordinal <= 32u )
+				{
+					std::fprintf( stderr,
+						"[RW-GPU-MAP] fallback #%lu dim=%u sub=%u requestedMap=%u usage=%u cpu=0x%X bind=0x%X misc=0x%X format=%u bytes=%u size=%ux%ux%u mips=%u array=%u samples=%u:%u\n",
+						ordinal,
+						unsigned( desc.dimension ),
+						subresource,
+					unsigned( map ),
+					unsigned( desc.usage ),
+					desc.cpuAccess,
+					desc.bind,
+					desc.misc,
+					unsigned( desc.format ),
+					desc.byteWidth,
+					desc.width,
+					desc.height,
+					desc.depth,
+					desc.mipLevels,
+					desc.arraySize,
+					desc.sampleCount,
+					desc.sampleQuality );
+				std::fflush( stderr );
+			}
+		}
+
+		inline HRESULT createStaging( ID3D11Device * device
+			, ID3D11Resource * source
+			, ResourceDesc & resourceDesc
+			, ID3D11Resource *& result )noexcept
+		{
+			result = nullptr;
+			D3D11_RESOURCE_DIMENSION dimension{ D3D11_RESOURCE_DIMENSION_UNKNOWN };
+			source->GetType( &dimension );
+			resourceDesc.dimension = dimension;
+
+			switch ( dimension )
+			{
+			case D3D11_RESOURCE_DIMENSION_BUFFER:
+				{
+					auto buffer = static_cast< ID3D11Buffer * >( source );
+					D3D11_BUFFER_DESC desc{};
+					buffer->GetDesc( &desc );
+					resourceDesc.usage = desc.Usage;
+					resourceDesc.cpuAccess = desc.CPUAccessFlags;
+					resourceDesc.bind = desc.BindFlags;
+					resourceDesc.misc = desc.MiscFlags;
+					resourceDesc.byteWidth = desc.ByteWidth;
+					resourceDesc.width = desc.ByteWidth;
+					desc.Usage = D3D11_USAGE_STAGING;
+					desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+					desc.BindFlags = 0u;
+					desc.MiscFlags = 0u;
+					desc.StructureByteStride = 0u;
+					ID3D11Buffer * staging{};
+					auto const hr = device->CreateBuffer( &desc, nullptr, &staging );
+					result = staging;
+					return hr;
+				}
+			case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
+				{
+					auto texture = static_cast< ID3D11Texture1D * >( source );
+					D3D11_TEXTURE1D_DESC desc{};
+					texture->GetDesc( &desc );
+					resourceDesc.usage = desc.Usage;
+					resourceDesc.cpuAccess = desc.CPUAccessFlags;
+					resourceDesc.bind = desc.BindFlags;
+					resourceDesc.misc = desc.MiscFlags;
+					resourceDesc.width = desc.Width;
+					resourceDesc.mipLevels = desc.MipLevels;
+					resourceDesc.arraySize = desc.ArraySize;
+					resourceDesc.format = desc.Format;
+					desc.Usage = D3D11_USAGE_STAGING;
+					desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+					desc.BindFlags = 0u;
+					desc.MiscFlags = 0u;
+					ID3D11Texture1D * staging{};
+					auto const hr = device->CreateTexture1D( &desc, nullptr, &staging );
+					result = staging;
+					return hr;
+				}
+			case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
+				{
+					auto texture = static_cast< ID3D11Texture2D * >( source );
+					D3D11_TEXTURE2D_DESC desc{};
+					texture->GetDesc( &desc );
+					resourceDesc.usage = desc.Usage;
+					resourceDesc.cpuAccess = desc.CPUAccessFlags;
+					resourceDesc.bind = desc.BindFlags;
+					resourceDesc.misc = desc.MiscFlags;
+					resourceDesc.width = desc.Width;
+					resourceDesc.height = desc.Height;
+					resourceDesc.mipLevels = desc.MipLevels;
+					resourceDesc.arraySize = desc.ArraySize;
+					resourceDesc.sampleCount = desc.SampleDesc.Count;
+					resourceDesc.sampleQuality = desc.SampleDesc.Quality;
+					resourceDesc.format = desc.Format;
+
+					// D3D11 does not permit multisampled STAGING textures.  Do not
+					// silently construct a non-equivalent single-sample companion.
+					if ( desc.SampleDesc.Count > 1u )
+					{
+						return E_NOTIMPL;
+					}
+
+					desc.Usage = D3D11_USAGE_STAGING;
+					desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+					desc.BindFlags = 0u;
+					desc.MiscFlags = 0u;
+					ID3D11Texture2D * staging{};
+					auto const hr = device->CreateTexture2D( &desc, nullptr, &staging );
+					result = staging;
+					return hr;
+				}
+			case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
+				{
+					auto texture = static_cast< ID3D11Texture3D * >( source );
+					D3D11_TEXTURE3D_DESC desc{};
+					texture->GetDesc( &desc );
+					resourceDesc.usage = desc.Usage;
+					resourceDesc.cpuAccess = desc.CPUAccessFlags;
+					resourceDesc.bind = desc.BindFlags;
+					resourceDesc.misc = desc.MiscFlags;
+					resourceDesc.width = desc.Width;
+					resourceDesc.height = desc.Height;
+					resourceDesc.depth = desc.Depth;
+					resourceDesc.mipLevels = desc.MipLevels;
+					resourceDesc.format = desc.Format;
+					desc.Usage = D3D11_USAGE_STAGING;
+					desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+					desc.BindFlags = 0u;
+					desc.MiscFlags = 0u;
+					ID3D11Texture3D * staging{};
+					auto const hr = device->CreateTexture3D( &desc, nullptr, &staging );
+					result = staging;
+					return hr;
+				}
+			default:
+				return E_NOTIMPL;
+			}
+		}
+	}
+
+	/**
+	 * Maps an ObjectMemory native subresource without ever issuing an illegal
+	 * Map against a DEFAULT resource.  A transient STAGING resource is retained
+	 * in ObjectMemory only between this call and unlock().
+	 */
+	inline HRESULT lock( ObjectMemory const & memory
+		, ID3D11DeviceContext * context
+		, UINT nativeSubresource
+		, D3D11_MAPPED_SUBRESOURCE & data )
+	{
+		data = {};
+		detail::ResourceDesc desc{};
+
+		if ( !memory.resource || !context )
+		{
+			detail::trace( "lock-invalid-argument", E_POINTER, desc, nativeSubresource, memory.mapFlags );
+			return E_POINTER;
+		}
+
+		memory.resource->GetType( &desc.dimension );
+		if ( memory.mapStaging )
+		{
+			detail::trace( "lock-already-staged", E_FAIL, desc, nativeSubresource, memory.mapFlags );
+			return E_FAIL;
+		}
+
+		// createStaging reads the exact descriptor before cloning it.  It is also
+		// used for direct-map classification so no map decision is inferred from
+		// Vulkan allocation flags alone.
+		ID3D11Resource * staging{};
+		detail::DeviceRef device;
+		memory.resource->GetDevice( &device.value );
+		if ( !device.value )
+		{
+			detail::trace( "lock-no-device", E_FAIL, desc, nativeSubresource, memory.mapFlags );
+			return E_FAIL;
+		}
+
+		// Populate the descriptor without allocating: clone construction happens
+		// below only when direct Map is illegal.  A tiny probe is avoided because
+		// a helper must not allocate a staging object for a direct map.
+		switch ( desc.dimension )
+		{
+		case D3D11_RESOURCE_DIMENSION_BUFFER:
+			{
+				D3D11_BUFFER_DESC source{};
+				static_cast< ID3D11Buffer * >( memory.resource )->GetDesc( &source );
+				desc.usage = source.Usage;
+				desc.cpuAccess = source.CPUAccessFlags;
+				desc.bind = source.BindFlags;
+				desc.misc = source.MiscFlags;
+				desc.byteWidth = source.ByteWidth;
+				desc.width = source.ByteWidth;
+				break;
+			}
+		case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
+			{
+				D3D11_TEXTURE1D_DESC source{};
+				static_cast< ID3D11Texture1D * >( memory.resource )->GetDesc( &source );
+				desc.usage = source.Usage;
+				desc.cpuAccess = source.CPUAccessFlags;
+				desc.bind = source.BindFlags;
+				desc.misc = source.MiscFlags;
+				desc.width = source.Width;
+				desc.mipLevels = source.MipLevels;
+				desc.arraySize = source.ArraySize;
+				desc.format = source.Format;
+				break;
+			}
+		case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
+			{
+				D3D11_TEXTURE2D_DESC source{};
+				static_cast< ID3D11Texture2D * >( memory.resource )->GetDesc( &source );
+				desc.usage = source.Usage;
+				desc.cpuAccess = source.CPUAccessFlags;
+				desc.bind = source.BindFlags;
+				desc.misc = source.MiscFlags;
+				desc.width = source.Width;
+				desc.height = source.Height;
+				desc.mipLevels = source.MipLevels;
+				desc.arraySize = source.ArraySize;
+				desc.sampleCount = source.SampleDesc.Count;
+				desc.sampleQuality = source.SampleDesc.Quality;
+				desc.format = source.Format;
+				break;
+			}
+		case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
+			{
+				D3D11_TEXTURE3D_DESC source{};
+				static_cast< ID3D11Texture3D * >( memory.resource )->GetDesc( &source );
+				desc.usage = source.Usage;
+				desc.cpuAccess = source.CPUAccessFlags;
+				desc.bind = source.BindFlags;
+				desc.misc = source.MiscFlags;
+				desc.width = source.Width;
+				desc.height = source.Height;
+				desc.depth = source.Depth;
+				desc.mipLevels = source.MipLevels;
+				desc.format = source.Format;
+				break;
+			}
+		default:
+			detail::trace( "lock-unsupported-dimension", E_NOTIMPL, desc, nativeSubresource, memory.mapFlags );
+			return E_NOTIMPL;
+		}
+
+		if ( !detail::isSubresource( desc, nativeSubresource ) )
+		{
+			detail::trace( "lock-invalid-subresource", E_INVALIDARG, desc, nativeSubresource, memory.mapFlags );
+			return E_INVALIDARG;
+		}
+
+		if ( detail::isDirectStagingMap( desc, memory.mapFlags )
+				|| detail::isDirectDynamicMap( desc, memory.mapFlags ) )
+			{
+				auto const hr = context->Map( memory.resource, nativeSubresource, memory.mapFlags, 0u, &data );
+				if ( FAILED( hr ) || !data.pData )
+				{
+					auto const failure = FAILED( hr ) ? hr : E_FAIL;
+					if ( SUCCEEDED( hr ) ) context->Unmap( memory.resource, nativeSubresource );
+					data = {};
+					detail::trace( "lock-direct-map", failure, desc, nativeSubresource, memory.mapFlags );
+					return failure;
+				}
+				return hr;
+			}
+
+		if ( !detail::canCopyBack( desc ) )
+		{
+			detail::trace( "lock-immutable-unsupported", E_NOTIMPL, desc, nativeSubresource, memory.mapFlags );
+			return E_NOTIMPL;
+		}
+
+		detail::traceFallback( desc, nativeSubresource, memory.mapFlags );
+		auto hr = detail::createStaging( device.value, memory.resource, desc, staging );
+		if ( FAILED( hr ) || !staging )
+		{
+			auto const failure = FAILED( hr ) ? hr : E_FAIL;
+			detail::trace( "lock-create-staging", failure, desc, nativeSubresource, memory.mapFlags );
+			if ( staging )
+			{
+				staging->Release();
+			}
+			return failure;
+		}
+
+		// Copy only the caller's native subresource.  That deliberately retains
+		// the renderer's mip-prefix/native-index convention unchanged.
+		context->CopySubresourceRegion( staging, nativeSubresource, 0u, 0u, 0u
+			, memory.resource, nativeSubresource, nullptr );
+		hr = context->Map( staging, nativeSubresource, D3D11_MAP_READ_WRITE, 0u, &data );
+		if ( FAILED( hr ) || !data.pData )
+		{
+			auto const failure = FAILED( hr ) ? hr : E_FAIL;
+			if ( SUCCEEDED( hr ) ) context->Unmap( staging, nativeSubresource );
+			data = {};
+			detail::trace( "lock-stage-map", failure, desc, nativeSubresource, D3D11_MAP_READ_WRITE );
+			staging->Release();
+			return failure;
+		}
+
+		memory.mapStaging = staging;
+		return hr;
+	}
+
+	/**
+	 * Completes a lock().  Transient staging resources are copied back only for
+	 * the native subresource that the caller supplies, then immediately released.
+	 */
+	inline void unlock( ObjectMemory const & memory
+		, ID3D11DeviceContext * context
+		, UINT nativeSubresource )
+	{
+		if ( !context )
+		{
+			detail::ResourceDesc desc{};
+			detail::trace( "unlock-invalid-context", E_POINTER, desc, nativeSubresource, memory.mapFlags );
+			return;
+		}
+
+		if ( memory.mapStaging )
+		{
+			auto staging = memory.mapStaging;
+			context->Unmap( staging, nativeSubresource );
+			if ( memory.resource )
+			{
+				context->CopySubresourceRegion( memory.resource, nativeSubresource, 0u, 0u, 0u
+					, staging, nativeSubresource, nullptr );
+			}
+			else
+			{
+				detail::ResourceDesc desc{};
+				detail::trace( "unlock-missing-source", E_POINTER, desc, nativeSubresource, memory.mapFlags );
+			}
+			memory.mapStaging = nullptr;
+			staging->Release();
+			return;
+		}
+
+		if ( memory.resource )
+		{
+			context->Unmap( memory.resource, nativeSubresource );
+		}
+	}
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11ShadowTexture.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11ShadowTexture.hpp
new file mode 100644
index 00000000..e2f9712d
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11ShadowTexture.hpp
@@ -0,0 +1,219 @@
+#pragma once
+
+// Included after ashesd3d11_api.hpp by D3D11DeviceMemory.cpp.
+// Real D3D11 texture transfers; no Vulkan results or GPU properties are changed.
+namespace ashes::D3D11_NAMESPACE
+{
+    namespace shadowtex
+    {
+        struct Range
+        {
+            ID3D11Texture2D *texture{};
+            D3D11_TEXTURE2D_DESC desc{};
+            VkDeviceSize offset{};
+            UINT rowBytes{};
+            UINT rows{};
+            UINT sliceBytes{};
+            UINT nativeSubresource{};
+            bool touched{};
+        };
+
+        inline bool prepare(ObjectMemory const &memory, UINT subresource,
+            VkDeviceSize requestOffset, VkDeviceSize requestSize, Range &range)
+        {
+            if (!memory.resource) return false;
+            D3D11_RESOURCE_DIMENSION dimension{};
+            memory.resource->GetType(&dimension);
+            if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) return false;
+            range.texture = static_cast<ID3D11Texture2D *>(memory.resource);
+            range.texture->GetDesc(&range.desc);
+            if (subresource >= memory.subresources.size())
+            {
+                checkError(memory.device, E_INVALIDARG, "TextureShadowSubresource");
+                return true;
+            }
+            if (range.desc.MipLevels <= memory.mipPrefix)
+            {
+                checkError(memory.device, E_INVALIDARG, "TextureShadowNativeMipCount");
+                return true;
+            }
+            auto logicalMips = range.desc.MipLevels - memory.mipPrefix;
+            range.nativeSubresource = D3D11CalcSubresource(subresource % logicalMips + memory.mipPrefix,
+                subresource / logicalMips, range.desc.MipLevels);
+            range.offset = memory.offset;
+            for (UINT i = 0; i < subresource; ++i)
+            {
+                if (range.offset > memory.allocateInfo.allocationSize ||
+                    memory.subresources[i].SysMemSlicePitch > memory.allocateInfo.allocationSize - range.offset)
+                {
+                    checkError(memory.device, E_INVALIDARG, "TextureShadowOffset");
+                    return true;
+                }
+                range.offset += memory.subresources[i].SysMemSlicePitch;
+            }
+            auto const &layout = memory.subresources[subresource];
+            range.rowBytes = layout.SysMemPitch;
+            range.sliceBytes = layout.SysMemSlicePitch;
+            if (!range.rowBytes || !range.sliceBytes ||
+                range.offset > memory.allocateInfo.allocationSize ||
+                range.sliceBytes > memory.allocateInfo.allocationSize - range.offset)
+            {
+                checkError(memory.device, E_INVALIDARG, "TextureShadowRange");
+                return true;
+            }
+            range.rows = range.sliceBytes / range.rowBytes;
+            auto end = range.offset + range.sliceBytes;
+            range.touched = requestSize == WholeSize;
+            if (!range.touched && requestOffset < memory.allocateInfo.allocationSize)
+            {
+                auto requestEnd = requestOffset + std::min(requestSize,
+                    memory.allocateInfo.allocationSize - requestOffset);
+                range.touched = requestOffset < end && requestEnd > range.offset;
+            }
+            return true;
+        }
+
+        // v12: the shadow holds Vulkan-visible BC blocks; the native texture is
+        // RGBA8. Decode the whole logical subresource and write it natively.
+        inline bool uploadDecoded(ObjectMemory const &memory, DeviceContextLock const &context,
+            uint8_t const *data, Range const &range)
+        {
+            auto const mip = range.nativeSubresource % range.desc.MipLevels;
+            auto const width = std::max(1u, range.desc.Width >> mip);
+            auto const height = std::max(1u, range.desc.Height >> mip);
+            auto const blocksWide = (width + 3u) / 4u;
+            auto const blockRows = (height + 3u) / 4u;
+            if (range.rowBytes < blocksWide * bc::blockBytes(memory.decodedFrom) || range.rows < blockRows)
+            {
+                checkError(memory.device, E_INVALIDARG, "TextureShadowDecodedLayout");
+                return true;
+            }
+            auto const pitch = blocksWide * 16u;
+            std::vector<uint8_t> decoded(size_t(pitch) * blockRows * 4u);
+            if (!bcdecode::rows(memory.decodedFrom, data + range.offset, range.rowBytes, blocksWide, blockRows,
+                decoded.data(), pitch))
+            {
+                checkError(memory.device, E_INVALIDARG, "TextureShadowDecode");
+                return true;
+            }
+            if (range.desc.Usage == D3D11_USAGE_DEFAULT)
+            {
+                D3D11_BOX box{ 0u, 0u, 0u, width, height, 1u };
+                (*context)->UpdateSubresource(range.texture, range.nativeSubresource, &box,
+                    decoded.data(), pitch, pitch * blockRows * 4u);
+                return true;
+            }
+            D3D11_MAPPED_SUBRESOURCE mapped{};
+            auto access = range.desc.Usage == D3D11_USAGE_DYNAMIC
+                ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_READ_WRITE;
+            auto hr = (*context)->Map(range.texture, range.nativeSubresource, access, 0u, &mapped);
+            if (FAILED(hr) || !mapped.pData || mapped.RowPitch < width * 4u)
+            {
+                checkError(memory.device, FAILED(hr) ? hr : E_INVALIDARG, "MapTextureShadowDecodedUpload");
+                if (SUCCEEDED(hr) && mapped.pData) (*context)->Unmap(range.texture, range.nativeSubresource);
+                return true;
+            }
+            for (UINT row = 0; row < height; ++row)
+            {
+                std::memcpy(static_cast<uint8_t *>(mapped.pData) + VkDeviceSize(row) * mapped.RowPitch,
+                    decoded.data() + VkDeviceSize(row) * pitch, size_t(width) * 4u);
+            }
+            (*context)->Unmap(range.texture, range.nativeSubresource);
+            return true;
+        }
+
+        inline bool upload(ObjectMemory const &memory, DeviceContextLock const &context,
+            uint8_t const *data, UINT subresource, VkDeviceSize requestOffset, VkDeviceSize requestSize)
+        {
+            Range range{};
+            if (!prepare(memory, subresource, requestOffset, requestSize, range)) return false;
+            if (!range.touched || !range.rows) return true;
+            if (memory.decodedFrom != VK_FORMAT_UNDEFINED)
+            {
+                return uploadDecoded(memory, context, data, range);
+            }
+            if (range.desc.Usage == D3D11_USAGE_DEFAULT)
+            {
+                // Pipeline-bound textures are not CPU-mappable. Upload the current
+                // complete subresource shadow, retaining unchanged bytes in that mip.
+                (*context)->UpdateSubresource(range.texture, range.nativeSubresource, nullptr,
+                    data + range.offset, range.rowBytes, range.sliceBytes);
+                return true;
+            }
+            D3D11_MAPPED_SUBRESOURCE mapped{};
+            auto access = range.desc.Usage == D3D11_USAGE_DYNAMIC
+                ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_READ_WRITE;
+            auto hr = (*context)->Map(range.texture, range.nativeSubresource, access, 0u, &mapped);
+            if (FAILED(hr) || !mapped.pData || mapped.RowPitch < range.rowBytes)
+            {
+                checkError(memory.device, FAILED(hr) ? hr : E_INVALIDARG, "MapTextureShadowUpload");
+                if (SUCCEEDED(hr) && mapped.pData) (*context)->Unmap(range.texture, range.nativeSubresource);
+                return true;
+            }
+            for (UINT row = 0; row < range.rows; ++row)
+            {
+                std::memcpy(static_cast<uint8_t *>(mapped.pData) + VkDeviceSize(row) * mapped.RowPitch,
+                    data + range.offset + VkDeviceSize(row) * range.rowBytes, range.rowBytes);
+            }
+            (*context)->Unmap(range.texture, range.nativeSubresource);
+            return true;
+        }
+
+        inline bool download(ObjectMemory const &memory, DeviceContextLock const &context,
+            uint8_t *data, UINT subresource, VkDeviceSize requestOffset, VkDeviceSize requestSize)
+        {
+            Range range{};
+            if (!prepare(memory, subresource, requestOffset, requestSize, range)) return false;
+            if (!range.touched || !range.rows) return true;
+            if (memory.decodedFrom != VK_FORMAT_UNDEFINED)
+            {
+                // RGBA8 cannot be re-encoded into the original BC blocks. The
+                // shadow keeps the last host-written BC bytes, which remain
+                // exact unless the GPU wrote the image (only transfers can).
+                uint32_t const key[] = { uint32_t(memory.decodedFrom), subresource };
+                rdiag::report("bc-decoded-host-readback", rdiag::hashBytes(0x5244u, key, sizeof(key)),
+                    "vkFormat=%u subresource=%u action=kept-host-shadow reason=decoded-rgba8-backing-cannot-be-re-encoded",
+                    unsigned(memory.decodedFrom), subresource);
+                return true;
+            }
+            ID3D11Texture2D *staging{};
+            ID3D11Texture2D *readable = range.texture;
+            if (range.desc.Usage != D3D11_USAGE_STAGING)
+            {
+                auto desc = range.desc;
+                desc.Usage = D3D11_USAGE_STAGING;
+                desc.BindFlags = 0u;
+                desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+                desc.MiscFlags = 0u;
+                auto hr = get(memory.device)->getDevice()->CreateTexture2D(&desc, nullptr, &staging);
+                if (FAILED(hr) || !staging)
+                {
+                    checkError(memory.device, FAILED(hr) ? hr : E_INVALIDARG, "CreateTextureShadowReadback");
+                    safeRelease(staging);
+                    return true;
+                }
+                (*context)->CopyResource(staging, range.texture);
+                readable = staging;
+            }
+            D3D11_MAPPED_SUBRESOURCE mapped{};
+            auto hr = (*context)->Map(readable, range.nativeSubresource, D3D11_MAP_READ, 0u, &mapped);
+            if (SUCCEEDED(hr) && mapped.pData && mapped.RowPitch >= range.rowBytes)
+            {
+                for (UINT row = 0; row < range.rows; ++row)
+                {
+                    std::memcpy(data + range.offset + VkDeviceSize(row) * range.rowBytes,
+                        static_cast<uint8_t const *>(mapped.pData) + VkDeviceSize(row) * mapped.RowPitch,
+                        range.rowBytes);
+                }
+                (*context)->Unmap(readable, range.nativeSubresource);
+            }
+            else
+            {
+                checkError(memory.device, FAILED(hr) ? hr : E_INVALIDARG, "MapTextureShadowReadback");
+                if (SUCCEEDED(hr) && mapped.pData) (*context)->Unmap(readable, range.nativeSubresource);
+            }
+            safeRelease(staging);
+            return true;
+        }
+    }
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11StateCache.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11StateCache.hpp
new file mode 100644
index 00000000..9e7b2632
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11StateCache.hpp
@@ -0,0 +1,166 @@
+/*
+This file belongs to Ashes.
+See LICENSE file in root folder.
+*/
+#pragma once
+
+#include <cstdlib>
+#include <cstdio>
+#include <map>
+
+namespace ashes::D3D11_NAMESPACE::statecache
+{
+	enum class Stage : uint8_t
+	{
+		compute,
+		vertex,
+		geometry,
+		hull,
+		domain,
+		pixel,
+	};
+
+	enum class Kind : uint8_t
+	{
+		sampler,
+		srv,
+		constantBuffer,
+	};
+
+	struct Key
+	{
+		Stage stage{};
+		Kind kind{};
+		UINT slot{};
+
+		bool operator<( Key const & rhs )const noexcept
+		{
+			return stage != rhs.stage ? stage < rhs.stage
+				: kind != rhs.kind ? kind < rhs.kind
+				: slot < rhs.slot;
+		}
+	};
+
+	struct Value
+	{
+		void * pointer{};
+		UINT firstConstant{};
+		UINT numConstants{};
+		bool extended{};
+
+		bool operator==( Value const & rhs )const noexcept
+		{
+			return pointer == rhs.pointer
+				&& firstConstant == rhs.firstConstant
+				&& numConstants == rhs.numConstants
+				&& extended == rhs.extended;
+		}
+	};
+
+	struct Statistics
+	{
+		uint64_t hits{};
+		uint64_t misses{};
+		uint64_t invalidations{};
+	};
+
+	inline bool getEnvFlag( char const * name, bool defaultValue )
+	{
+		if ( auto value = std::getenv( name ) )
+		{
+			return value[0] != '0';
+		}
+		return defaultValue;
+	}
+
+	inline bool isEnabled()
+	{
+		return getEnvFlag( "RW_HD5500_STATE_CACHE", false );
+	}
+
+	inline bool diagnosticsEnabled()
+	{
+		return getEnvFlag( "RW_HD5500_D3D_DIAGNOSTICS", false );
+	}
+
+	// The cache owns no D3D objects; pointer identity is valid while the native context
+	// retains its binding. Unknown slots are deliberately absent rather than represented
+	// by a null pointer, because null can itself be a valid native binding.
+	class Cache
+	{
+	public:
+		bool needsSet( Stage stage, Kind kind, UINT slot, void * pointer, UINT first = 0u, UINT count = 0u, bool extended = false )
+		{
+			if ( !isEnabled() )
+			{
+				++m_stats.misses;
+				return true;
+			}
+
+			Key key{ stage, kind, slot };
+			Value value{ pointer, first, count, extended };
+			auto it = m_values.find( key );
+			if ( it != m_values.end() && it->second == value )
+			{
+				++m_stats.hits;
+				return false;
+			}
+			m_values[key] = value;
+			++m_stats.misses;
+			return true;
+		}
+
+		void invalidate() noexcept
+		{
+			m_values.clear();
+			++m_stats.invalidations;
+		}
+
+		Statistics const & getStatistics()const noexcept
+		{
+			return m_stats;
+		}
+
+	private:
+		std::map< Key, Value > m_values;
+		Statistics m_stats;
+	};
+
+	// Aggregation is intentionally process-wide: CommandBuffer contexts may be immediate
+	// or short-lived deferred contexts, while the counters describe every actual setter
+	// decision made by this renderer DLL instance.
+	struct Aggregate
+	{
+		uint64_t hits{};
+		uint64_t misses{};
+		uint64_t invalidations{};
+		bool reported{};
+
+		~Aggregate()
+		{
+			if ( diagnosticsEnabled() && !reported )
+			{
+				reported = true;
+				std::fprintf( stderr, "[RW-GPU-STATECACHE] hits=%llu misses=%llu invalidations=%llu\n"
+					, static_cast< unsigned long long >( hits )
+					, static_cast< unsigned long long >( misses )
+					, static_cast< unsigned long long >( invalidations ) );
+			}
+		}
+	};
+
+	inline Aggregate & aggregate()
+	{
+		static Aggregate result;
+		return result;
+	}
+
+	inline void collect( Cache const & cache ) noexcept
+	{
+		auto const & stats = cache.getStatistics();
+		auto & all = aggregate();
+		all.hits += stats.hits;
+		all.misses += stats.misses;
+		all.invalidations += stats.invalidations;
+	}
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11TimestampPeriod.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11TimestampPeriod.hpp
new file mode 100644
index 00000000..441711e8
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11TimestampPeriod.hpp
@@ -0,0 +1,70 @@
+/*
+	This file belongs to Ashes.
+	See LICENSE file in root folder.
+*/
+#pragma once
+
+#include "renderer/D3D11Renderer/D3D11RendererPrerequisites.hpp"
+
+#include <cstdio>
+
+namespace ashes::D3D11_NAMESPACE::timestampperiod
+{
+	// D3D11 timestamp values have units of GPU ticks.  Probe the adapter once
+	// rather than claiming that one tick is one nanosecond.
+	inline float measure( IDXGIAdapter * adapter, D3D_FEATURE_LEVEL requestedFeatureLevel )noexcept
+	{
+		ID3D11Device * device{};
+		ID3D11DeviceContext * context{};
+		ID3D11Query * query{};
+		D3D_FEATURE_LEVEL actual{};
+		D3D_FEATURE_LEVEL const levels[]{ requestedFeatureLevel };
+		auto const fail = [&]( char const * reason )
+		{
+			std::fprintf( stderr, "[RW-GPU-TIMESTAMP] period fallback=1.0ns reason=%s\n", reason );
+			safeRelease( query );
+			safeRelease( context );
+			safeRelease( device );
+			return 1.0f;
+		};
+
+		if ( !adapter ) return fail( "no-adapter" );
+		auto hr = D3D11CreateDevice( adapter
+			, D3D_DRIVER_TYPE_UNKNOWN
+			, nullptr
+			, 0u
+			, levels
+			, 1u
+			, D3D11_SDK_VERSION
+			, &device
+			, &actual
+			, &context );
+		if ( FAILED( hr ) || !device || !context ) return fail( "D3D11CreateDevice" );
+
+		D3D11_QUERY_DESC desc{};
+		desc.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+		hr = device->CreateQuery( &desc, &query );
+		if ( FAILED( hr ) || !query ) return fail( "CreateQuery" );
+		context->Begin( query );
+		context->End( query );
+		context->Flush();
+
+		D3D11_QUERY_DATA_TIMESTAMP_DISJOINT result{};
+		auto const deadline = GetTickCount64() + 1000u;
+		for ( ;; )
+		{
+			hr = context->GetData( query, &result, UINT( sizeof( result ) ), D3D11_ASYNC_GETDATA_DONOTFLUSH );
+			if ( hr == S_OK ) break;
+			if ( FAILED( hr ) ) return fail( "GetData" );
+			if ( GetTickCount64() >= deadline ) return fail( "GetData-timeout" );
+			Sleep( 1u );
+		}
+
+		if ( result.Disjoint || !result.Frequency ) return fail( result.Disjoint ? "disjoint" : "zero-frequency" );
+		auto const period = float( 1000000000.0 / double( result.Frequency ) );
+		safeRelease( query );
+		safeRelease( context );
+		safeRelease( device );
+		return period > 0.0f ? period : 1.0f;
+	}
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/bcdec.h b/source/ashes/renderer/D3D11Renderer/Miscellaneous/bcdec.h
new file mode 100644
index 00000000..c70edc43
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/bcdec.h
@@ -0,0 +1,1512 @@
+/* bcdec.h - v0.985
+   provides functions to decompress blocks of BC compressed images
+   written by Sergii "iOrange" Kudlai in 2022
+
+   This library does not allocate memory and is trying to use as less stack as possible
+
+   This library was never optimized specifically for speed but for the overall size
+   it has zero external dependencies and is not using any runtime functions
+
+   This library was writtem by humans and will never contain any LLM-generated code
+
+   Supported BC formats:
+   BC1 (also known as DXT1) + it's "binary alpha" variant BC1A (DXT1A)
+   BC2 (also known as DXT3)
+   BC3 (also known as DXT5)
+   BC4 (also known as ATI1N)
+   BC5 (also known as ATI2N)
+   BC6H (HDR format)
+   BC7
+
+   BC1/BC2/BC3/BC7 are expected to decompress into 4*4 RGBA blocks 8bit per component (32bit pixel)
+   BC4/BC5 are expected to decompress into 4*4 R/RG blocks 8bit per component (8bit and 16bit pixel)
+   BC6H is expected to decompress into 4*4 RGB blocks of either 32bit float or 16bit "half" per
+   component (96bit or 48bit pixel)
+
+   For more info, issues and suggestions please visit https://github.com/iOrange/bcdec
+
+   Configuration:
+      #define BCDEC_BC4BC5_PRECISE:
+         enables more precise but slower BC4/BC5 decoding + signed/unsigned mode
+
+   CREDITS:
+      Aras Pranckevicius (@aras-p)      - BC1/BC3 decoders optimizations (up to 3x the speed)
+                                        - BC6H/BC7 bits pulling routines optimizations
+                                        - optimized BC6H by moving unquantize out of the loop
+                                        - Split BC6H decompression function into 'half' and
+                                          'float' variants
+
+      Michael Schmidt (@RunDevelopment) - Found better "magic" coefficients for integer interpolation
+                                          of reference colors in BC1 color block, that match with
+                                          the floating point interpolation. This also made it faster
+                                          than integer division by 3!
+
+   bugfixes:
+      @linkmauve
+      @wkjarosz
+
+   LICENSE: See end of file for license information.
+*/
+
+#ifndef BCDEC_HEADER_INCLUDED
+#define BCDEC_HEADER_INCLUDED
+
+#define BCDEC_VERSION_MAJOR 0
+#define BCDEC_VERSION_MINOR 985
+
+/* if BCDEC_STATIC causes problems, try defining BCDECDEF to 'inline' or 'static inline' */
+#ifndef BCDECDEF
+#ifdef BCDEC_STATIC
+#define BCDECDEF    static
+#else
+#ifdef __cplusplus
+#define BCDECDEF    extern "C"
+#else
+#define BCDECDEF    extern
+#endif
+#endif
+#endif
+
+/*  Used information sources:
+    https://docs.microsoft.com/en-us/windows/win32/direct3d10/d3d10-graphics-programming-guide-resources-block-compression
+    https://docs.microsoft.com/en-us/windows/win32/direct3d11/bc6h-format
+    https://docs.microsoft.com/en-us/windows/win32/direct3d11/bc7-format
+    https://docs.microsoft.com/en-us/windows/win32/direct3d11/bc7-format-mode-reference
+
+    ! WARNING ! Khronos's BPTC partitions tables contain mistakes, do not use them!
+    https://www.khronos.org/registry/DataFormat/specs/1.1/dataformat.1.1.html#BPTC
+
+    ! Use tables from here instead !
+    https://www.khronos.org/registry/OpenGL/extensions/ARB/ARB_texture_compression_bptc.txt
+
+    Leaving it here as it's a nice read
+    https://fgiesen.wordpress.com/2021/10/04/gpu-bcn-decoding/
+
+    Fast half to float function from here
+    https://gist.github.com/rygorous/2144712
+*/
+
+#define BCDEC_BC1_BLOCK_SIZE    8
+#define BCDEC_BC2_BLOCK_SIZE    16
+#define BCDEC_BC3_BLOCK_SIZE    16
+#define BCDEC_BC4_BLOCK_SIZE    8
+#define BCDEC_BC5_BLOCK_SIZE    16
+#define BCDEC_BC6H_BLOCK_SIZE   16
+#define BCDEC_BC7_BLOCK_SIZE    16
+
+#define BCDEC_BC1_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC1_BLOCK_SIZE)
+#define BCDEC_BC2_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC2_BLOCK_SIZE)
+#define BCDEC_BC3_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC3_BLOCK_SIZE)
+#define BCDEC_BC4_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC4_BLOCK_SIZE)
+#define BCDEC_BC5_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC5_BLOCK_SIZE)
+#define BCDEC_BC6H_COMPRESSED_SIZE(w, h)    ((((w)>>2)*((h)>>2))*BCDEC_BC6H_BLOCK_SIZE)
+#define BCDEC_BC7_COMPRESSED_SIZE(w, h)     ((((w)>>2)*((h)>>2))*BCDEC_BC7_BLOCK_SIZE)
+
+BCDECDEF void bcdec_bc1(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+BCDECDEF void bcdec_bc2(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+BCDECDEF void bcdec_bc3(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+#ifndef BCDEC_BC4BC5_PRECISE
+BCDECDEF void bcdec_bc4(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+BCDECDEF void bcdec_bc5(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+#else
+BCDECDEF void bcdec_bc4(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+BCDECDEF void bcdec_bc5(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+BCDECDEF void bcdec_bc4_float(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+BCDECDEF void bcdec_bc5_float(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+#endif
+BCDECDEF void bcdec_bc6h_float(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+BCDECDEF void bcdec_bc6h_half(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int isSigned);
+BCDECDEF void bcdec_bc7(const void* compressedBlock, void* decompressedBlock, int destinationPitch);
+
+#endif /* BCDEC_HEADER_INCLUDED */
+
+#ifdef BCDEC_IMPLEMENTATION
+
+static unsigned short bcdec__getu16le(const void* s) {
+    unsigned short l = (unsigned short)((const unsigned char*)s)[0];
+    unsigned short h = (unsigned short)((const unsigned char*)s)[1];
+    return l | (h << 8);
+}
+static unsigned int bcdec__getu32le(const void* s) {
+    unsigned int l = bcdec__getu16le(s);
+    unsigned int h = bcdec__getu16le((const unsigned char*)s + 2);
+    return l | (h << 16);
+}
+static unsigned long long bcdec__getu64le(const void* s) {
+    unsigned long long l = bcdec__getu32le(s);
+    unsigned long long h = bcdec__getu32le((const unsigned char*)s + 4);
+    return l | (h << 32);
+}
+
+static void bcdec__color_block(const void* compressedBlock, void* decompressedBlock, int destinationPitch, int onlyOpaqueMode) {
+    unsigned short c0, c1;
+    unsigned int refColors[4]; /* 0xAABBGGRR */
+    unsigned char* dstColors;
+    unsigned int colorIndices;
+    int i, j, idx;
+    unsigned int r0, g0, b0, r1, g1, b1, r, g, b;
+
+    c0 = bcdec__getu16le(compressedBlock);
+    c1 = bcdec__getu16le((const unsigned char*)compressedBlock + 2);
+
+    /* Unpack 565 ref colors */
+    r0 = (c0 >> 11) & 0x1F;
+    g0 = (c0 >> 5)  & 0x3F;
+    b0 =  c0        & 0x1F;
+
+    r1 = (c1 >> 11) & 0x1F;
+    g1 = (c1 >> 5)  & 0x3F;
+    b1 =  c1        & 0x1F;
+
+    /* Expand 565 ref colors to 888 */
+    r = (r0 * 527 + 23) >> 6;
+    g = (g0 * 259 + 33) >> 6;
+    b = (b0 * 527 + 23) >> 6;
+    refColors[0] = 0xFF000000 | (b << 16) | (g << 8) | r;
+
+    r = (r1 * 527 + 23) >> 6;
+    g = (g1 * 259 + 33) >> 6;
+    b = (b1 * 527 + 23) >> 6;
+    refColors[1] = 0xFF000000 | (b << 16) | (g << 8) | r;
+
+    if (c0 > c1 || onlyOpaqueMode) {    /* Standard BC1 mode (also BC3 color block uses ONLY this mode) */
+        /* color_2 = 2/3*color_0 + 1/3*color_1
+           color_3 = 1/3*color_0 + 2/3*color_1 */
+        r = ((2 * r0 + r1) *  351 +   61) >>  7;
+        g = ((2 * g0 + g1) * 2763 + 1039) >> 11;
+        b = ((2 * b0 + b1) *  351 +   61) >>  7;
+        refColors[2] = 0xFF000000 | (b << 16) | (g << 8) | r;
+
+        r = ((r0 + r1 * 2) *  351 +   61) >>  7;
+        g = ((g0 + g1 * 2) * 2763 + 1039) >> 11;
+        b = ((b0 + b1 * 2) *  351 +   61) >>  7;
+        refColors[3] = 0xFF000000 | (b << 16) | (g << 8) | r;
+    } else {                            /* Quite rare BC1A mode */
+        /* color_2 = 1/2*color_0 + 1/2*color_1;
+           color_3 = 0;                         */
+        r = ((r0 + r1) * 1053 +  125) >>  8;
+        g = ((g0 + g1) * 4145 + 1019) >> 11;
+        b = ((b0 + b1) * 1053 +  125) >>  8;
+        refColors[2] = 0xFF000000 | (b << 16) | (g << 8) | r;
+
+        refColors[3] = 0x00000000;
+    }
+
+    colorIndices = bcdec__getu32le((const unsigned char*)compressedBlock + 4);
+
+    /* Fill out the decompressed color block */
+    dstColors = (unsigned char*)decompressedBlock;
+    for (i = 0; i < 4; ++i) {
+        for (j = 0; j < 4; ++j) {
+            idx = colorIndices & 0x03;
+            ((unsigned int*)dstColors)[j] = refColors[idx];
+            colorIndices >>= 2;
+        }
+
