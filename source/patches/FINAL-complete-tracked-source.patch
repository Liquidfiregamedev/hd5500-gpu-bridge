+		case D3D11_UAV_DIMENSION_TEXTURE3D: result.firstMip = d.Texture3D.MipSlice; result.firstSlice = d.Texture3D.FirstWSlice; result.sliceCount = d.Texture3D.WSize; break;
+		default: result.wholeResource = true; break;
