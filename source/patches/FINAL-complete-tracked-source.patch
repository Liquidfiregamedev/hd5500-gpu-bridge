+					&& fakeDesc.ArraySize > 0u
+					&& realDesc.MipLevels > 0u
+					&& realDesc.ArraySize > 0u
+					&& box.left <= box.right
+					&& box.top <= box.bottom
+					&& box.right <= fakeDesc.Width
+					&& box.bottom <= fakeDesc.Height
