diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcCopy.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcCopy.hpp
new file mode 100644
index 00000000..d8e986f6
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcCopy.hpp
@@ -0,0 +1,20 @@
+#pragma once
+#include <vulkan/vulkan.h>
+
+namespace ashes::D3D11_NAMESPACE::bccopy
+{
+    // Whole-subresource selection is permitted only when both real native mip
+    // extents exactly match the requested copy. Never enlarge a partial region.
+    inline bool wholeSubresource(VkFormat format, VkImageCopy const &copy,
+        VkExtent3D const &src, VkExtent3D const &dst) noexcept
+    {
+        return format >= VK_FORMAT_BC1_RGB_UNORM_BLOCK
+            && format <= VK_FORMAT_BC7_SRGB_BLOCK
+            && copy.srcOffset.x == 0 && copy.srcOffset.y == 0 && copy.srcOffset.z == 0
+            && copy.dstOffset.x == 0 && copy.dstOffset.y == 0 && copy.dstOffset.z == 0
+            && copy.extent.width == src.width && copy.extent.height == src.height
+            && copy.extent.depth == src.depth
+            && copy.extent.width == dst.width && copy.extent.height == dst.height
+            && copy.extent.depth == dst.depth;
+    }
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcDecode.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcDecode.hpp
new file mode 100644
index 00000000..813eb4b8
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcDecode.hpp
@@ -0,0 +1,116 @@
+#pragma once
+
+// CPU decode of BC block rows into RGBA8 texels for the v12 decoded
+// representation (see D3D11BcLayout.hpp). Uses the vendored bcdec v0.985
+// (iOrange/bcdec, MIT or Unlicense; see licenses/bcdec-LICENSE.txt).
+#include "Miscellaneous/D3D11BcLayout.hpp"
+
+#include <cstdint>
+#include <cstring>
+
+#ifndef BCDEC_IMPLEMENTATION
+#	define BCDEC_STATIC
+#	define BCDEC_IMPLEMENTATION
+#	include "Miscellaneous/bcdec.h"
+#	undef BCDEC_IMPLEMENTATION
+#endif
+
+namespace ashes::D3D11_NAMESPACE::bcdecode
+{
+    // Decodes one 4x4 block into the RGBA8 destination (pitch in bytes).
+    inline bool block(VkFormat format, uint8_t const *src, uint8_t *dst, int pitch) noexcept
+    {
+        switch (format)
+        {
+        case VK_FORMAT_BC1_RGB_UNORM_BLOCK:
+        case VK_FORMAT_BC1_RGB_SRGB_BLOCK:
+            bcdec_bc1(src, dst, pitch);
+            // Vulkan BC1 RGB formats have no alpha: alpha always reads as 1.
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x) dst[y * pitch + x * 4 + 3] = 0xFFu;
+            return true;
+        case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+        case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+            bcdec_bc1(src, dst, pitch);
+            return true;
+        case VK_FORMAT_BC2_UNORM_BLOCK:
+        case VK_FORMAT_BC2_SRGB_BLOCK:
+            bcdec_bc2(src, dst, pitch);
+            return true;
+        case VK_FORMAT_BC3_UNORM_BLOCK:
+        case VK_FORMAT_BC3_SRGB_BLOCK:
+            bcdec_bc3(src, dst, pitch);
+            return true;
+        case VK_FORMAT_BC4_UNORM_BLOCK:
+        {
+            uint8_t r[16];
+            bcdec_bc4(src, r, 4);
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x)
+                {
+                    auto *p = dst + y * pitch + x * 4;
+                    p[0] = r[y * 4 + x]; p[1] = 0u; p[2] = 0u; p[3] = 0xFFu;
+                }
+            return true;
+        }
+        case VK_FORMAT_BC5_UNORM_BLOCK:
+        {
+            uint8_t rg[32];
+            bcdec_bc5(src, rg, 8);
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x)
+                {
+                    auto *p = dst + y * pitch + x * 4;
+                    p[0] = rg[y * 8 + x * 2]; p[1] = rg[y * 8 + x * 2 + 1]; p[2] = 0u; p[3] = 0xFFu;
+                }
+            return true;
+        }
+        case VK_FORMAT_BC7_UNORM_BLOCK:
+        case VK_FORMAT_BC7_SRGB_BLOCK:
+            bcdec_bc7(src, dst, pitch);
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    // Decodes `blockRows` rows of `blocksWide` blocks. `src` points at the first
+    // block of the first row, `srcRowPitch` is the byte distance between block
+    // rows. The destination receives 4*blockRows texel rows of 4*blocksWide
+    // RGBA8 texels with `dstPitch` bytes per texel row.
+    inline bool rows(VkFormat format, uint8_t const *src, uint64_t srcRowPitch,
+        uint32_t blocksWide, uint32_t blockRows, uint8_t *dst, uint32_t dstPitch) noexcept
+    {
+        auto const bytes = bc::blockBytes(format);
+        for (uint32_t by = 0u; by < blockRows; ++by)
+        {
+            auto const *rowSrc = src + by * srcRowPitch;
+            auto *rowDst = dst + uint64_t(by) * 4u * dstPitch;
+            for (uint32_t bx = 0u; bx < blocksWide; ++bx)
+            {
+                if (!block(format, rowSrc + uint64_t(bx) * bytes, rowDst + uint64_t(bx) * 16u, int(dstPitch))) return false;
+            }
+        }
+        return true;
+    }
+
+    // UpdateSubresource with a destination box on a deferred context applies
+    // the box offset to the source pointer when the driver lacks native
+    // command lists (documented D3D11 behaviour). Commands normally execute on
+    // the immediate context; this keeps the decoded upload correct either way.
+    inline void updateBox(ID3D11Device *device, ID3D11DeviceContext *context, ID3D11Resource *resource,
+        UINT subresource, D3D11_BOX const &box, uint8_t const *data, UINT rowPitch, UINT depthPitch) noexcept
+    {
+        auto const *adjusted = data;
+        if (context->GetType() == D3D11_DEVICE_CONTEXT_DEFERRED)
+        {
+            D3D11_FEATURE_DATA_THREADING threading{};
+            if (SUCCEEDED(device->CheckFeatureSupport(D3D11_FEATURE_THREADING, &threading, sizeof(threading)))
+                && !threading.DriverCommandLists)
+            {
+                adjusted = data - (uint64_t(box.front) * depthPitch) - (uint64_t(box.top) * rowPitch) - (uint64_t(box.left) * 4u);
+            }
+        }
+        context->UpdateSubresource(resource, subresource, &box, adjusted, rowPitch, depthPitch);
+    }
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcLayout.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcLayout.hpp
new file mode 100644
index 00000000..f3a09f3b
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BcLayout.hpp
@@ -0,0 +1,206 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+
+// BC resources require a block-aligned native base. A hidden mip prefix gives
+// an exact logical-sized mip/view, without changing Vulkan format or contents.
+//
+// v12: the hidden prefix multiplies the native base by up to 4 per axis. When
+// that expansion would exceed the D3D11 Texture2D limit (16384), a decodable
+// 2D BC image is instead stored as an RGBA8 texture of exactly the logical
+// size ("decoded" representation). The Vulkan-visible format, extent, mip
+// count, memory requirements and mapped layout stay the BC ones; only the
+// native backing differs. The decision is a pure function of
+// VkImageCreateInfo, so image creation, views, copies and capability queries
+// all agree on it.
+namespace ashes::D3D11_NAMESPACE::bc
+{
+    enum class Representation : uint32_t
+    {
+        NotBc = 0u,
+        NativeBc = 1u,
+        DecodedRgba8 = 2u,
+        Unsupported = 3u,
+    };
+
+    inline constexpr uint32_t MaxTexture2DAxis = 16384u;
+
+    inline bool isFormat(VkFormat format) noexcept
+    {
+        return format >= VK_FORMAT_BC1_RGB_UNORM_BLOCK && format <= VK_FORMAT_BC7_SRGB_BLOCK;
+    }
+
+    inline bool isSrgb(VkFormat format) noexcept
+    {
+        switch (format)
+        {
+        case VK_FORMAT_BC1_RGB_SRGB_BLOCK:
+        case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+        case VK_FORMAT_BC2_SRGB_BLOCK:
+        case VK_FORMAT_BC3_SRGB_BLOCK:
+        case VK_FORMAT_BC7_SRGB_BLOCK:
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    // Formats with an exact or conventional 8-bit UNORM decode. Signed BC4/BC5
+    // and HDR BC6H are deliberately excluded: an RGBA8 UNORM backing cannot
+    // represent their sampled values.
+    inline bool isDecodable(VkFormat format) noexcept
+    {
+        switch (format)
+        {
+        case VK_FORMAT_BC1_RGB_UNORM_BLOCK:
+        case VK_FORMAT_BC1_RGB_SRGB_BLOCK:
+        case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+        case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+        case VK_FORMAT_BC2_UNORM_BLOCK:
+        case VK_FORMAT_BC2_SRGB_BLOCK:
+        case VK_FORMAT_BC3_UNORM_BLOCK:
+        case VK_FORMAT_BC3_SRGB_BLOCK:
+        case VK_FORMAT_BC4_UNORM_BLOCK:
+        case VK_FORMAT_BC5_UNORM_BLOCK:
+        case VK_FORMAT_BC7_UNORM_BLOCK:
+        case VK_FORMAT_BC7_SRGB_BLOCK:
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    // RW_HD5500_BC_DECODE_FALLBACK=0 restores the v11 behaviour (oversized odd
+    // BC images fail with VK_ERROR_FORMAT_NOT_SUPPORTED).
+    inline bool decodeFallbackEnabled() noexcept
+    {
+        static bool const enabled = []()
+        {
+            char value[4]{};
+            auto const length = GetEnvironmentVariableA("RW_HD5500_BC_DECODE_FALLBACK", value, 4u);
+            return !(length == 1u && value[0] == '0');
+        }();
+        return enabled;
+    }
+
+    // The v1-v11 hidden-prefix rule, independent of representation.
+    inline UINT rawPrefix(VkImageCreateInfo const &info) noexcept
+    {
+        if (!isFormat(info.format) || info.imageType != VK_IMAGE_TYPE_2D) return 0u;
+        UINT result{};
+        while (result < 2u && (((info.extent.width << result) & 3u) || ((info.extent.height << result) & 3u))) ++result;
+        return result;
+    }
+
+    inline bool prefixFits(VkImageCreateInfo const &info) noexcept
+    {
+        auto const p = rawPrefix(info);
+        return (uint64_t(info.extent.width) << p) <= MaxTexture2DAxis
+            && (uint64_t(info.extent.height) << p) <= MaxTexture2DAxis;
+    }
+
+    // Usage bits that a decoded RGBA8 backing reproduces exactly: sampling and
+    // transfers that never need the original block bytes back.
+    inline bool decodedUsageSupported(VkImageUsageFlags usage) noexcept
+    {
+        VkImageUsageFlags const allowed = VK_IMAGE_USAGE_SAMPLED_BIT
+            | VK_IMAGE_USAGE_TRANSFER_DST_BIT
+            | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        return (usage & ~allowed) == 0u;
+    }
+
+    inline Representation representation(VkImageCreateInfo const &info) noexcept
+    {
+        if (!isFormat(info.format)) return Representation::NotBc;
+        if (info.imageType != VK_IMAGE_TYPE_2D || prefixFits(info)) return Representation::NativeBc;
+        if (decodeFallbackEnabled()
+            && isDecodable(info.format)
+            && info.extent.width <= MaxTexture2DAxis
+            && info.extent.height <= MaxTexture2DAxis
+            && info.samples == VK_SAMPLE_COUNT_1_BIT
+            && info.tiling == VK_IMAGE_TILING_OPTIMAL
+            && decodedUsageSupported(info.usage))
+        {
+            return Representation::DecodedRgba8;
+        }
+        return Representation::Unsupported;
+    }
+
+    inline bool isDecoded(VkImageCreateInfo const &info) noexcept
+    {
+        return representation(info) == Representation::DecodedRgba8;
+    }
+
+    inline char const *representationName(Representation value) noexcept
+    {
+        switch (value)
+        {
+        case Representation::NotBc: return "not-bc";
+        case Representation::NativeBc: return "native-bc";
+        case Representation::DecodedRgba8: return "decoded-rgba8";
+        default: return "unsupported";
+        }
+    }
+
+    inline VkFormat decodedFormat(VkFormat format) noexcept
+    {
+        return isSrgb(format) ? VK_FORMAT_R8G8B8A8_SRGB : VK_FORMAT_R8G8B8A8_UNORM;
+    }
+
+    // Vulkan format whose DXGI mapping is used for the native texture.
+    inline VkFormat nativeFormat(VkImageCreateInfo const &info) noexcept
+    {
+        return isDecoded(info) ? decodedFormat(info.format) : info.format;
+    }
+
+    // Vulkan format whose DXGI mapping is used for a native view of the image.
+    inline VkFormat nativeViewFormat(VkImageCreateInfo const &info, VkFormat viewFormat) noexcept
+    {
+        return isDecoded(info) && isFormat(viewFormat) ? decodedFormat(viewFormat) : viewFormat;
+    }
+
+    inline UINT prefix(VkImageCreateInfo const &info) noexcept
+    {
+        return isDecoded(info) ? 0u : rawPrefix(info);
+    }
+
+    inline UINT mipCount(VkImageCreateInfo const &info) noexcept
+    {
+        return info.mipLevels + prefix(info);
+    }
+
+    inline UINT subresource(VkImageCreateInfo const &info, UINT level, UINT layer) noexcept
+    {
+        return D3D11CalcSubresource(level + prefix(info), layer, mipCount(info));
+    }
+
+    inline UINT blockBytes(VkFormat format) noexcept
+    {
+        return (format >= VK_FORMAT_BC1_RGB_UNORM_BLOCK && format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK)
+            || format == VK_FORMAT_BC4_UNORM_BLOCK || format == VK_FORMAT_BC4_SNORM_BLOCK ? 8u : 16u;
+    }
+
+    inline UINT rowBytes(VkFormat format, UINT width) noexcept
+    {
+        return ((width + 3u) / 4u) * blockBytes(format);
+    }
+
+    inline UINT rows(UINT height) noexcept
+    {
+        return (height + 3u) / 4u;
+    }
+
+    // Bytes of a full mip chain for a given layout; used for diagnostics only.
+    inline uint64_t chainBytes(VkImageCreateInfo const &info, bool decoded) noexcept
+    {
+        uint64_t total{};
+        for (uint32_t level = 0u; level < info.mipLevels; ++level)
+        {
+            uint32_t const w = info.extent.width >> level ? info.extent.width >> level : 1u;
+            uint32_t const h = info.extent.height >> level ? info.extent.height >> level : 1u;
+            total += decoded ? uint64_t(w) * h * 4u : uint64_t(rowBytes(info.format, w)) * rows(h);
+        }
+        return total * (info.arrayLayers ? info.arrayLayers : 1u);
+    }
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BlitScratch.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BlitScratch.hpp
new file mode 100644
index 00000000..61bda726
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11BlitScratch.hpp
@@ -0,0 +1,206 @@
+/*
+This file belongs to Ashes.
+See LICENSE file in root folder.
+*/
+#pragma once
+
+#include "renderer/D3D11Renderer/D3D11RendererPrerequisites.hpp"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace ashes::D3D11_NAMESPACE::blitscratch
+{
+	// This small value type is intentionally independent of command recording so
+	// rectangle/layer planning can be unit-tested without a D3D11 device.
+	enum class LayoutKind
+	{
+		eCompact,
+		eFullFallback,
+		eInvalid,
+	};
+
+	struct Layout
+	{
+		LayoutKind kind{ LayoutKind::eInvalid };
+		char const * reason{ "empty-stretch-set" };
+		VkExtent3D atlasExtent{};
+		VkExtent3D scratchExtent{};
+		VkOffset3D bboxOrigin{};
+		uint32_t mipLevel{};
+		uint32_t baseArrayLayer{};
+		uint32_t layerCount{};
+
+		static Layout plan( VkImageCreateInfo const & destination
+			, ArrayView< VkImageBlit const > const & regions )noexcept
+		{
+			if ( destination.imageType != VK_IMAGE_TYPE_2D || destination.extent.depth != 1u )
+			{
+				Layout result{};
+				result.reason = "destination-not-2d";
+				return result;
+			}
+			return plan( destination.extent, destination.mipLevels, destination.arrayLayers, destination.flags
+				, regions.empty() ? nullptr : regions.data(), regions.size() );
+		}
+
+		static Layout plan( VkImageCreateInfo const & destination
+			, std::vector< VkImageBlit > const & regions )noexcept
+		{
+			if ( destination.imageType != VK_IMAGE_TYPE_2D || destination.extent.depth != 1u )
+			{
+				Layout result{};
+				result.reason = "destination-not-2d";
+				return result;
+			}
+			return plan( destination.extent, destination.mipLevels, destination.arrayLayers, destination.flags
+				, regions.data(), regions.size() );
+		}
+
+		static Layout plan( VkExtent3D const & atlasExtent
+			, uint32_t atlasMipLevels
+			, uint32_t atlasLayers
+			, VkImageCreateFlags imageFlags
+			, VkImageBlit const * regions
+			, size_t count ) noexcept
+		{
+			Layout result{};
+			result.atlasExtent = atlasExtent;
+			result.scratchExtent = atlasExtent;
+			result.layerCount = atlasLayers;
+
+			if ( !atlasExtent.width || !atlasExtent.height || !atlasMipLevels || !atlasLayers )
+			{
+				result.reason = "invalid-destination-image-bounds";
+				return result;
+			}
+
+			if ( !regions || !count )
+			{
+				return result;
+			}
+
+			uint32_t const commonMip = regions[0].dstSubresource.mipLevel;
+			int32_t minX = ( std::numeric_limits< int32_t >::max )();
+			int32_t minY = ( std::numeric_limits< int32_t >::max )();
+			int32_t maxX = ( std::numeric_limits< int32_t >::min )();
+			int32_t maxY = ( std::numeric_limits< int32_t >::min )();
+			uint32_t minLayer = ( std::numeric_limits< uint32_t >::max )();
+			uint64_t maxLayer = 0u;
+			bool sameMip = true;
+
+			for ( size_t index = 0u; index < count; ++index )
+			{
+				auto const & region = regions[index];
+				auto const & subresource = region.dstSubresource;
+				if ( subresource.mipLevel >= atlasMipLevels || subresource.mipLevel >= 32u
+					|| subresource.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT
+					|| !subresource.layerCount
+					|| region.dstOffsets[0].x < 0 || region.dstOffsets[0].y < 0
+					|| region.dstOffsets[0].z != 0 || region.dstOffsets[1].z != 1
+					|| region.dstOffsets[1].x <= region.dstOffsets[0].x
+					|| region.dstOffsets[1].y <= region.dstOffsets[0].y )
+				{
+					result.reason = "invalid-destination-region";
+					return result;
+				}
+				sameMip = sameMip && subresource.mipLevel == commonMip;
+
+				auto const layerEnd = uint64_t( subresource.baseArrayLayer ) + subresource.layerCount;
+				if ( !atlasLayers || layerEnd > atlasLayers )
+				{
+					result.reason = "destination-layer-range";
+					return result;
+				}
+
+				auto const mipWidth = atlasExtent.width >> subresource.mipLevel;
+				auto const mipHeight = atlasExtent.height >> subresource.mipLevel;
+				auto const width = mipWidth ? mipWidth : 1u;
+				auto const height = mipHeight ? mipHeight : 1u;
+				if ( region.dstOffsets[1].x > int32_t( width )
+					|| region.dstOffsets[1].y > int32_t( height ) )
+				{
+					result.reason = "destination-rectangle-out-of-mip";
+					return result;
+				}
+
+				minX = ( std::min )( minX, region.dstOffsets[0].x );
+				minY = ( std::min )( minY, region.dstOffsets[0].y );
+				maxX = ( std::max )( maxX, region.dstOffsets[1].x );
+				maxY = ( std::max )( maxY, region.dstOffsets[1].y );
+				minLayer = ( std::min )( minLayer, subresource.baseArrayLayer );
+				maxLayer = ( std::max )( maxLayer, layerEnd );
+			}
+
+			// A compact texture has one mip.  A batch that names several destination
+			// mips is valid, but it must retain the established full-clone path.
+			if ( !sameMip )
+			{
+				result.kind = LayoutKind::eFullFallback;
+				result.reason = "multiple-destination-mips";
+				return result;
+			}
+
+			if ( imageFlags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT )
+			{
+				result.kind = LayoutKind::eFullFallback;
+				result.reason = "cube-compatible-image";
+				return result;
+			}
+
+			if ( maxX <= minX || maxY <= minY || maxLayer <= minLayer
+				|| maxLayer - minLayer > ( std::numeric_limits< uint32_t >::max )() )
+			{
+				result.reason = "unrepresentable-compact-bounds";
+				return result;
+			}
+
+			result.kind = LayoutKind::eCompact;
+			result.reason = "common-mip-bbox";
+			result.scratchExtent = VkExtent3D
+			{
+				uint32_t( maxX - minX ),
+				uint32_t( maxY - minY ),
+				1u,
+			};
+			result.bboxOrigin = VkOffset3D{ minX, minY, 0 };
+			result.mipLevel = commonMip;
+			result.baseArrayLayer = minLayer;
+			result.layerCount = uint32_t( maxLayer - minLayer );
+			return result;
+		}
+
+		VkImageBlit makeLocalDestination( VkImageBlit const & original )const noexcept
+		{
+			VkImageBlit result = original;
+			result.dstSubresource.mipLevel = 0u;
+			result.dstSubresource.baseArrayLayer -= baseArrayLayer;
+			result.dstOffsets[0].x -= bboxOrigin.x;
+			result.dstOffsets[0].y -= bboxOrigin.y;
+			result.dstOffsets[1].x -= bboxOrigin.x;
+			result.dstOffsets[1].y -= bboxOrigin.y;
+			return result;
+		}
+
+		VkImageCopy makeCopyBack( VkImageBlit const & original )const noexcept
+		{
+			auto const local = makeLocalDestination( original );
+			return VkImageCopy
+			{
+				local.dstSubresource,
+				local.dstOffsets[0],
+				original.dstSubresource,
+				original.dstOffsets[0],
+				VkExtent3D
+				{
+					uint32_t( original.dstOffsets[1].x - original.dstOffsets[0].x ),
+					uint32_t( original.dstOffsets[1].y - original.dstOffsets[0].y ),
+					1u,
+				},
+			};
+		}
+	};
+}
diff --git a/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11CommandTrace.hpp b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11CommandTrace.hpp
new file mode 100644
index 00000000..46e2c385
--- /dev/null
+++ b/source/ashes/renderer/D3D11Renderer/Miscellaneous/D3D11CommandTrace.hpp
@@ -0,0 +1,124 @@
+#pragma once
+#include <d3d11.h>
+#include <d3d11sdklayers.h>
+#include <windows.h>
+#include <cstdio>
+#include <vector>
+
+namespace ashes::D3D11_NAMESPACE::cmdtrace
+{
+	inline bool enabled()
+	{
+		char flag[2]{};
+		return GetEnvironmentVariableA("RW_HD5500_COMMAND_TRACE",flag,2u)==1u && flag[0]=='1';
+	}
+	inline bool serialEnabled()
+	{
+		char flag[2]{};
+		return GetEnvironmentVariableA("RW_HD5500_SERIAL_CHECKPOINTS",flag,2u)==1u && flag[0]=='1';
+	}
+	inline volatile LONG commandCounter{};
+	inline volatile LONG printedMessageCounter{};
+	class Trace
+	{
+	public:
+		explicit Trace(ID3D11Device * device,ID3D11DeviceContext * context)
+			: m_device(device),m_context(context),m_enabled(enabled()),m_serial(serialEnabled())
+		{
+			if (!m_enabled) return;
+			if (m_serial)
+			{
+				D3D11_QUERY_DESC desc{}; desc.Query=D3D11_QUERY_EVENT;
+				auto hr=m_device->CreateQuery(&desc,&m_query);
+				if (FAILED(hr) || !m_query)
+				{
+					std::fprintf(stderr,"[RW-GPU-CHECKPOINT] query-unavailable hr=0x%08lX; trace-only, no completion claim\n",static_cast<unsigned long>(hr));
+					m_serial=false;
+				}
+			}
+			m_device->QueryInterface(__uuidof(ID3D11InfoQueue),reinterpret_cast<void **>(&m_queue));
+			if(m_queue) m_messageCursor=m_queue->GetNumStoredMessagesAllowedByRetrievalFilter();
+			m_start=GetTickCount64();
+		}
+		~Trace()
+		{
+			if(m_queue) m_queue->Release();
+			if(m_query) m_query->Release();
+		}
+		Trace(Trace const &)=delete;
+		Trace & operator=(Trace const &)=delete;
+		LONG before(char const * operation)
+		{
+			if(!m_enabled) return 0;
+			auto id=InterlockedIncrement(&commandCounter);
+			if(id<=8192)
+			{
+				std::fprintf(stderr,"[RW-GPU-COMMAND] BEGIN id=%ld tick=%llu type=%s removedReason=0x%08lX\n",long(id),static_cast<unsigned long long>(GetTickCount64()),operation,static_cast<unsigned long>(m_device->GetDeviceRemovedReason()));
+				std::fflush(stderr);
+			}
+			else if(id==8193)
+			{
+				std::fprintf(stderr,"[RW-GPU-COMMAND] trace/serial limit reached (8192); rendering continues unmodified\n");
+				std::fflush(stderr);
+			}
+			return id;
+		}
+		void after(LONG id,char const * operation)
+		{
+			if(!m_enabled || !id || id>8192) return;
+			auto reason=m_device->GetDeviceRemovedReason();
+			HRESULT queryHr=S_FALSE; BOOL completed=FALSE; bool timedOut=false;
+			if(m_serial && m_query && SUCCEEDED(reason))
+			{
+				m_context->End(m_query);
+				m_context->Flush();
+				auto begin=GetTickCount64();
+				for(;;)
+				{
+					queryHr=m_context->GetData(m_query,&completed,sizeof(completed),D3D11_ASYNC_GETDATA_DONOTFLUSH);
+					if(FAILED(queryHr) || (queryHr==S_OK && completed)) break;
+					reason=m_device->GetDeviceRemovedReason();
+					if(FAILED(reason)) break;
+					if(GetTickCount64()-begin>=2000u || GetTickCount64()-m_start>=30000u)
+					{
+						timedOut=true; m_serial=false; break;
+					}
+					Sleep(1u);
+				}
+			}
+			reason=m_device->GetDeviceRemovedReason();
+			std::fprintf(stderr,"[RW-GPU-COMMAND] END id=%ld type=%s removedReason=0x%08lX queryHr=0x%08lX gpuComplete=%u timeout=%u serialStillActive=%u\n",long(id),operation,static_cast<unsigned long>(reason),static_cast<unsigned long>(queryHr),unsigned(queryHr==S_OK && completed),unsigned(timedOut),unsigned(m_serial));
+			if(m_queue)
+			{
+				auto end=m_queue->GetNumStoredMessagesAllowedByRetrievalFilter();
+				if(end<m_messageCursor) m_messageCursor=0u;
+				for(auto i=m_messageCursor;i<end;++i)
+				{
+					SIZE_T size{};
+					if(FAILED(m_queue->GetMessage(i,nullptr,&size)) || !size || size>65536u) continue;
+					try
+					{
+						std::vector<unsigned char> buffer(size);
+						auto message=reinterpret_cast<D3D11_MESSAGE *>(buffer.data());
+						if(SUCCEEDED(m_queue->GetMessage(i,message,&size)) && message->Severity<=D3D11_MESSAGE_SEVERITY_WARNING && message->pDescription)
+						{
+							if(InterlockedIncrement(&printedMessageCounter)<=128)
+								std::fprintf(stderr,"[RW-GPU-COMMAND-MESSAGE] commandId=%ld type=%s messageId=%u severity=%u text=%.1536s\n",long(id),operation,unsigned(message->ID),unsigned(message->Severity),message->pDescription);
+						}
+					}
+					catch(...) { /* Optional capture must not replace the real rendering result. */ }
+				}
+				m_messageCursor=end;
+			}
+			std::fflush(stderr);
+		}
+	private:
+		ID3D11Device * m_device{};
+		ID3D11DeviceContext * m_context{};
+		ID3D11Query * m_query{};
+		ID3D11InfoQueue * m_queue{};
+		bool m_enabled{},m_serial{};
+		UINT64 m_messageCursor{};
+		ULONGLONG m_start{};
+	};
+}
