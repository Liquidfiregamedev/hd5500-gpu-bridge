#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D dst;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x < 8 && p.y < 8)
        imageStore(dst, p, vec4(161.0 / 255.0, 178.0 / 255.0, 195.0 / 255.0, 212.0 / 255.0));
}
