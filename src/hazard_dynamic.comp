#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std140) uniform Params { uint value; uint index; } params;
layout(set = 0, binding = 4, std430) buffer Output { uint data[]; } outbuf;
