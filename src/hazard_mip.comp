#version 450
layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 3) uniform usampler2D srcMip0;
layout(set = 0, binding = 11, rgba8ui) uniform writeonly uimage2D dstMip1;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x < 4 && p.y < 4)
        imageStore(dstMip1, p, texelFetch(srcMip0, p * 2, 0));
}
